# ===================================================================
# CONFIGURACIÓN PARA HETZNER CON OPENAI
# ===================================================================
# Este archivo contiene la configuración optimizada para deployment
# en un servidor Hetzner usando OpenAI como proveedor de IA
# ===================================================================

# ===================================================================
# CONFIGURACIÓN DE API - IMPORTANTE PARA HETZNER
# ===================================================================
# Reemplaza "your-domain.com" con tu dominio real o IP del servidor
# Ejemplos:
# - Con dominio: https://notebook.tudominio.com
# - Con IP: http://123.456.789.012:5055
# - Durante desarrollo/pruebas: http://localhost:5055
API_URL=https://your-domain.com

# Para single-container deployment (recomendado para Hetzner)
# No necesitas cambiar esto
# INTERNAL_API_URL=http://localhost:5055

# ===================================================================
# SEGURIDAD - OBLIGATORIO PARA SERVIDOR PÚBLICO
# ===================================================================
# Establece una contraseña segura para proteger tu instancia
# Esta contraseña protege tanto la interfaz web como los endpoints de API
OPEN_NOTEBOOK_PASSWORD=ChangeThisToASecurePassword123!

# ===================================================================
# OPENAI - PROVEEDOR PRINCIPAL DE IA
# ===================================================================
# Obtén tu API key en: https://platform.openai.com/api-keys
# Asegúrate de tener al menos $5 de crédito en tu cuenta
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===================================================================
# BASE DE DATOS SURREALDB
# ===================================================================
# Para single-container deployment en Hetzner
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=production

# ===================================================================
# TIMEOUTS - AJUSTADOS PARA PRODUCCIÓN EN LA NUBE
# ===================================================================
# Timeouts generosos para OpenAI cloud API
API_CLIENT_TIMEOUT=300
ESPERANTO_LLM_TIMEOUT=60

# ===================================================================
# PROVEEDORES ADICIONALES (OPCIONAL)
# ===================================================================
# Descomenta y configura si quieres usar más proveedores

# ANTHROPIC (Claude)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# GOOGLE GEMINI (Excelente para contextos largos y podcasts)
# GOOGLE_API_KEY=your-google-api-key

# GROQ (Inferencia rápida y gratuita)
# GROQ_API_KEY=gsk_your-groq-key

# OPENROUTER (Acceso a 100+ modelos)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ELEVENLABS (TTS profesional para podcasts)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# TTS_BATCH_SIZE=2

# ===================================================================
# WEB SCRAPING AVANZADO (OPCIONAL)
# ===================================================================
# FIRECRAWL - Scraping profesional: https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# JINA - Reader API: https://jina.ai/
# JINA_API_KEY=

# ===================================================================
# DEBUGGING (DESACTIVA EN PRODUCCIÓN)
# ===================================================================
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="Open Notebook"
